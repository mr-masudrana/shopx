generator client {
  provider   = "prisma-client-js"
  // No native Rust query engine binary — this is what was breaking on
  // Termux/Android (it kept downloading an x86_64 binary that can't
  // load on your phone's ARM64 architecture, no matter which
  // binaryTargets we tried). This mode ("Prisma ORM without Rust
  // engines", GA since v6.15) uses the @prisma/adapter-pg driver
  // adapter instead, so there's no native binary to mismatch at all.
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         String   @default("customer") // "customer" | "admin"
  createdAt    DateTime @default(now())

  orders    Order[]
  wishlist  WishlistItem[]
}

model Order {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  items         Json
  shipping      Json
  paymentMethod String
  subtotal      Float
  shippingCost  Float
  tax           Float
  total         Float
  status        String   @default("placed")
  createdAt     DateTime @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  productId Int
  product   Json
  addedAt   DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Product {
  id                   Int      @id @default(autoincrement())
  title                String
  description          String
  category             String
  price                Float
  discountPercentage   Float    @default(0)
  rating               Float    @default(0)
  stock                Int      @default(0)
  tags                 String[] @default([])
  brand                String?
  sku                  String?
  weight               Float?
  dimensions           Json?
  warrantyInformation  String?
  shippingInformation  String?
  availabilityStatus   String?  @default("In Stock")
  returnPolicy         String?
  minimumOrderQuantity Int?     @default(1)
  images               String[]
  thumbnail            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([category])
}
